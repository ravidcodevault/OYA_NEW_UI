@{
    var isAuthenticated = ViewBag.isAuthenticated;
    var isAuthorizeduser = ViewBag.isAuthorizeduser;
    var technicalError = ViewBag.TehnicalError;

    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Sign In - OYA</title>


    <!-- =====================================================
         INTER FONT
         ===================================================== -->

    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />


    <!-- =====================================================
         METRONIC
         ===================================================== -->

    <link href="~/assets/plugins/global/plugins.bundle.css"
          rel="stylesheet"
          type="text/css" />

    <link href="~/assets/css/style.bundle.css"
          rel="stylesheet"
          type="text/css" />


    <!-- =====================================================
         OYA LOGIN CSS
         ===================================================== -->

    <link href="~/assets/css/oya-login.css"
          rel="stylesheet"
          type="text/css"
          asp-append-version="true" />

</head>


<body>


    <div class="oya-login-page">


        <!-- =====================================================
         MAIN LOGIN WRAPPER
         ===================================================== -->

        <div class="oya-login-wrapper">


            <!-- =================================================
             LEFT BRAND SECTION
             ================================================= -->

            <section class="oya-brand-section">


                <!-- =================================================
                 BRAND HEADER
                 ================================================= -->

                


                <!-- =================================================
                 MAIN OYA LOGO
                 ================================================= -->

                <div class="oya-logo-area">

                    <img src="~/assets/media/logo/OYA_Logo.png"
                         alt="OYA Logo"
                         class="oya-main-logo"
                         onerror="this.style.display='none';" />

                </div>


                <!-- =================================================
                 BRAND CONTENT
                 ================================================= -->

                <div class="oya-brand-content">


                    <h1>

                        Fast, Efficient

                        <br />

                        <span>
                            and Productive.
                        </span>

                    </h1>


                    <p>
                        Everything you need to manage your
                        OYA business efficiently.
                    </p>


                    <!-- =================================================
                     FEATURES
                     ================================================= -->

                    <div class="oya-features">


                        <div class="oya-feature">

                            <span class="oya-feature-check">
                                ✓
                            </span>

                            <span>
                                Business Management
                            </span>

                        </div>


                        <div class="oya-feature">

                            <span class="oya-feature-check">
                                ✓
                            </span>

                            <span>
                                QuickBooks Integration
                            </span>

                        </div>


                        <div class="oya-feature">

                            <span class="oya-feature-check">
                                ✓
                            </span>

                            <span>
                                Reports &amp; Analytics
                            </span>

                        </div>


                    </div>

                </div>


            </section>


            <!-- =================================================
             RIGHT LOGIN SECTION
             ================================================= -->

            <section class="oya-login-section">


                <div class="oya-login-card">


                    <!-- =================================================
                     LOGIN HEADING
                     ================================================= -->

                    <div class="oya-login-heading">

                        <h2>
                            Welcome back
                        </h2>

                        <p>
                            Sign in to continue to your OYA Business Portal.
                        </p>

                    </div>


                    <!-- =================================================
                     LOGIN FORM
                     ================================================= -->

                    <form id="kt_sign_in_form"
                          class="oya-login-form"
                          method="post"
                          action="@Url.Action("Login", "Authentication")">

                        @if (!string.IsNullOrWhiteSpace(ViewBag.MicrosoftSsoError as string))
                        {
                            <div class="oya-login-message" role="alert">
                                <span class="oya-message-icon">!</span>
                                <span>@ViewBag.MicrosoftSsoError</span>
                            </div>
                        }


                        <!-- =================================================
                         USERNAME
                         ================================================= -->

                        <div class="oya-form-group">

                            <label for="username">
                                Username
                            </label>


                            <div class="oya-input-wrapper">


                                <span class="oya-input-icon">

                                    <svg viewBox="0 0 24 24"
                                         aria-hidden="true">

                                        <path d="M12 12a4.5 4.5 0 1 0 0-9
                                        4.5 4.5 0 0 0 0 9Zm0 2
                                        c-4.42 0-8 2.24-8 5v1h16v-1
                                        c0-2.76-3.58-5-8-5Z" />

                                    </svg>

                                </span>


                                <input type="text"
                                       id="username"
                                       name="username"
                                       placeholder="Enter your username"
                                       autocomplete="username"
                                       required />

                            </div>

                        </div>


                        <!-- =================================================
                         PASSWORD
                         ================================================= -->

                        <div class="oya-form-group">

                            <label for="password">
                                Password
                            </label>


                            <div class="oya-input-wrapper">


                                <span class="oya-input-icon">

                                    <svg viewBox="0 0 24 24"
                                         aria-hidden="true">

                                        <path d="M17 9h-1V7a4 4 0 0 0-8 0v2H7
                                        a2 2 0 0 0-2 2v8a2 2 0 0 0
                                        2 2h10a2 2 0 0 0 2-2v-8a2
                                        2 0 0 0-2-2Zm-7-2a2 2 0 1
                                        1 4 0v2h-4V7Zm7 12H7v-8h10v8Z" />

                                    </svg>

                                </span>


                                <input type="password"
                                       id="password"
                                       name="password"
                                       placeholder="Enter your password"
                                       autocomplete="current-password"
                                       required />


                                <!-- PASSWORD TOGGLE -->

                                <button type="button"
                                        class="oya-password-toggle"
                                        id="oyaPasswordToggle"
                                        aria-label="Show password">


                                    <svg id="oyaEyeIcon"
                                         viewBox="0 0 24 24"
                                         aria-hidden="true">

                                        <path d="M12 5c-5.5 0-9.5 4.5-10.5 7
                                        C2.5 14.5 6.5 19 12 19
                                        s9.5-4.5 10.5-7C21.5
                                        9.5 17.5 5 12 5Zm0 11.5A4.5
                                        4.5 0 1 1 12 7a4.5 4.5
                                        0 0 1 0 9.5Zm0-2A2.5
                                        2.5 0 1 0 12 9a2.5 2.5
                                        0 0 0 0 5.5Z" />

                                    </svg>

                                </button>


                            </div>

                        </div>


                        <!-- =================================================
                         ERROR MESSAGES
                         ================================================= -->
                        @if (ViewBag.isAuthenticated == "Error")
                        {

                            <div class="oya-login-message">

                                <span class="oya-message-icon">
                                    !
                                </span>

                                <span>
                                    Invalid username or password.
                                    Please try again.
                                </span>

                            </div>

                        }
                        else if (ViewBag.isAuthorizeduser == "Error")
                        {

                            <div class="oya-login-message">

                                <span class="oya-message-icon">
                                    !
                                </span>

                                <span>
                                    You are not authorized to perform
                                    this operation. Please try again.
                                </span>

                            </div>

                        }
                        else if (technicalError?.ToLower() == "true")
                        {

                            <div class="oya-login-message">

                                <span class="oya-message-icon">
                                    !
                                </span>

                                <span>
                                    Unable to process the request.
                                    Please try again.
                                </span>

                            </div>

                        }


                        <!-- =================================================
                         SIGN IN BUTTON
                         ================================================= -->

                        <button type="submit"
                                id="kt_sign_in_submit"
                                class="oya-sign-in-button">

                            <span>
                                Sign In
                            </span>

                            <span class="oya-button-arrow">
                                →
                            </span>

                        </button>

                        <div class="oya-login-divider"><span>OR</span></div>

                        <a class="oya-microsoft-button"
                           href="@Url.Action("MicrosoftLogin", "Authentication")">
                            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <path fill="#f25022" d="M1 1h10v10H1z" />
                                <path fill="#7fba00" d="M13 1h10v10H13z" />
                                <path fill="#00a4ef" d="M1 13h10v10H1z" />
                                <path fill="#ffb900" d="M13 13h10v10H13z" />
                            </svg>
                            <span>Sign in with Microsoft</span>
                        </a>


                        <!-- =================================================
                         ACCOUNT HELP
                         ================================================= -->

                        <div class="oya-login-help">

                            <span>
                                Don't have an account?
                            </span>

                            <strong>
                                Contact your Admin
                            </strong>

                        </div>


                        <!-- =================================================
                         SECURITY
                         ================================================= -->

                        <div class="oya-security">

                            <svg viewBox="0 0 24 24"
                                 aria-hidden="true">

                                <path d="M12 2 4 5v6c0 5.25 3.45 9.82
                                8 11 4.55-1.18 8-5.75 8-11V5l-8-3Zm0
                                17.8c-3.25-1.15-6-4.65-6-8.8V6.38l6-2.25
                                6 2.25V11c0 4.15-2.75 7.65-6
                                8.8ZM10.8 14.8 8 12l1.4-1.4
                                1.4 1.4 3.8-3.8L16 9.6l-5.2 5.2Z" />

                            </svg>

                            <span>
                                Your connection is secure
                            </span>

                        </div>


                    </form>


                </div>


            </section>


            <!-- =================================================
             FOOTER

IMPORTANT:
             FOOTER IS OUTSIDE BOTH PANELS.

Therefore it is centered against the COMPLETE
             .oya-login-wrapper.
             ================================================= -->

            <div class="oya-brand-footer">

                <span>
                    © @DateTime.Now.Year AMNIKON TECHNOLOGIES
                </span>

                <span class="oya-footer-dot"></span>

                <span>
                    OYA - Own Your Art
                </span>

            </div>


        </div>


    </div>


    <!-- =====================================================
     METRONIC JAVASCRIPT
     ===================================================== -->

    <script src="~/assets/plugins/global/plugins.bundle.js"></script>

    <script src="~/assets/js/scripts.bundle.js"></script>


    <!-- =====================================================
     PASSWORD TOGGLE
     ===================================================== -->

    <script>

            document.addEventListener("DOMContentLoaded", function() {

                const passwordInput =
                    document.getElementById("password");

                const passwordToggle =
                    document.getElementById("oyaPasswordToggle");

                const eyeIcon =
                    document.getElementById("oyaEyeIcon");


                if (!passwordInput || !passwordToggle || !eyeIcon) {
                    return;
                }


                passwordToggle.addEventListener("click", function() {

                    const isPassword =
                        passwordInput.type === "password";


                    passwordInput.type =
                        isPassword ? "text" : "password";


                    passwordToggle.setAttribute(
                        "aria-label",
                        isPassword
                            ? "Hide password"
                            : "Show password"
                    );


                    if (isPassword) {

                        eyeIcon.innerHTML = `
                                <path d="M3 3.7 4.3 2.4l17.3 17.3-1.3
                                         1.3-3.05-3.05A10.7 10.7 0 0 1 12
                                         19c-5.5 0-9.5-4.5-10.5-7 .45-1.15
                                         1.6-2.9 3.3-4.45L3 3.7Zm5.1 5.1
                                         1.5 1.5A2.5 2.5 0 0 0 13.7 14l1.5
                                         1.5A4.5 4.5 0 0 1 8.1 8.8Zm3.9-3.3
                                         c5.5 0 9.5 4.5 10.5 7-.5 1.25-2
                                         3.65-4.55 5.2l-1.45-1.45c1.8-1.1
                                         3.2-2.75 4-3.75-.95-1.55-4-5-8.5-5
                                         -.55 0-1.1.05-1.6.15L9.1 5.65c.9-.1
                                         1.85-.15 2.9-.15Z"/>
                            `;

                    }
                    else {

                        eyeIcon.innerHTML = `
                                <path d="M12 5c-5.5 0-9.5 4.5-10.5 7
                                         C2.5 14.5 6.5 19 12 19
                                         s9.5-4.5 10.5-7C21.5 9.5
                                         17.5 5 12 5Zm0 11.5A4.5
                                         4.5 0 1 1 12 7a4.5 4.5
                                         0 0 1 0 9.5Zm0-2A2.5
                                         2.5 0 1 0 12 9a2.5 2.5
                                         0 0 0 0 5.5Z"/>
                            `;

                    }

                });

            });

    </script>


</body>

</html>
